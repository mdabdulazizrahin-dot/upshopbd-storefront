# ===========================================
# ShopBD Environment Configuration
# ===========================================
# Copy this file to .env and configure values
# ===========================================

# ===========================================
# Backend Configuration (Choose One)
# ===========================================

# Option 1: Supabase (Recommended)
# --------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Option 2: Custom Backend
# ------------------------
# VITE_API_BASE_URL=https://api.yourdomain.com

# ===========================================
# Site Configuration
# ===========================================

VITE_SITE_NAME=ShopBD
VITE_SITE_URL=https://yourdomain.com
VITE_SITE_DESCRIPTION=Your One-Stop E-commerce Shop in Bangladesh

# ===========================================
# Authentication (Optional)
# ===========================================

# Google OAuth Client ID (for Google Sign-In)
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===========================================
# File Storage Configuration
# ===========================================

# Storage Type: 'supabase', 'local', or 's3'
VITE_STORAGE_TYPE=supabase

# For local storage
# VITE_STORAGE_URL=/uploads

# For S3/DigitalOcean Spaces
# VITE_S3_BUCKET=your-bucket-name
# VITE_S3_REGION=ap-south-1
# VITE_S3_ACCESS_KEY=your-access-key
# VITE_S3_SECRET_KEY=your-secret-key
# VITE_S3_ENDPOINT=https://your-endpoint.digitaloceanspaces.com

# Maximum file size in bytes (default: 50MB)
VITE_STORAGE_MAX_SIZE=52428800

# ===========================================
# Production Settings
# ===========================================

# Set to 'production' for live deployment
NODE_ENV=development

# Disable debug mode in production
VITE_DEBUG=false

# ===========================================
# Optional Features
# ===========================================

# Analytics (Google Analytics ID)
# VITE_GA_ID=G-XXXXXXXXXX

# Sentry Error Tracking
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ===========================================
# DO NOT COMMIT THIS FILE WITH REAL VALUES!
# ===========================================
